# 個人資料環境變數 —— 複製成 .env 後填值
#
#   cp .env.example .env
#
# .env 已在 .gitignore 中，不會被提交。
# GitHub Actions 用同名 repository secrets（Settings → Secrets and variables → Actions）。
#
# 為什麼要拆出來：這個網站是給應徵時當附件用的，repo 會是 public 的。
# 個資寫死在原始碼裡 = 個資公開，而且就算之後刪除也會留在 git 歷程裡。
#
# 只影響 /{lang}/resume/（A4 列印履歷）的欄位。其餘頁面維持零個資。

# 出生年月 YYYY-MM（列印履歷用）
PUBLIC_BIRTH=

# 手機
PUBLIC_MOBILE=

# 個人信箱（Web3Forms 表單收件信箱，同時是申請 web3forms access key 用的信箱）
PUBLIC_EMAIL=

# 公司信箱
PUBLIC_EMAIL_WORK=

# 辦公室電話 + 分機
PUBLIC_TEL_OFFICE=

# 完整地址（戶籍／列印履歷用）。英文欄位給英文版列印履歷。
PUBLIC_ADDRESS_ZH=
PUBLIC_ADDRESS_EN=
