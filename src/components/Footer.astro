---
import { useT, type Locale } from "../lib/i18n";
const { locale } = Astro.props as { locale: Locale };
const t = useT(locale);
const y = new Date().getFullYear();
---

<footer class="mt-16 w-full px-5 pb-10 text-center text-sm text-[var(--color-muted-foreground)] print-hide">
  <p>
    <span class="font-semibold text-[var(--color-secondary-foreground)]">劉士禎 / Shih-Chen Liu</span>
    <span class="mx-2">·</span>
    {t.hero.kicker}
  </p>
  <p class="mt-2 text-xs">{t.foot.rights} {y}</p>
  <p class="mt-1 text-xs">{t.foot.built}</p>
</footer>
