---
import { altPath, stripBase, type Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
  anchors?: { href: string; label: string }[];
}
const { locale, anchors: provided } = Astro.props;

/** 首頁用錨點導覽；子頁面退回一般頁面導覽。 */
const anchors: { href: string; label: string }[] =
  provided && provided.length > 0
    ? provided
    : [
        { href: `/${locale}/`, label: locale === "zh" ? "首頁" : "Home" },
        { href: `/${locale}/works/`, label: locale === "zh" ? "作品集" : "Projects" },
        { href: `/${locale}/notes/`, label: locale === "zh" ? "技術筆記" : "Notes" },
        { href: `/${locale}/resume/`, label: locale === "zh" ? "A4 履歷" : "Résumé" },
        { href: `/${locale}/about/`, label: locale === "zh" ? "關於" : "About" },
        { href: `/${locale}/contact/`, label: locale === "zh" ? "聯絡" : "Contact" },
      ];

const other = locale === "zh" ? "en" : "zh";
const otherLabel = locale === "zh" ? "EN" : "中文";
let href = altPath(stripBase(Astro.url.pathname, import.meta.env.BASE_URL), other);
// 中文首頁的正式位置是 / ，/zh/ 只會轉址
if (other === "zh" && href === "/zh/") href = "/";
---

<header class="w-full px-5 pt-5 md:fixed md:z-20 lg:max-w-7xl print-hide">
  <nav class="grid grid-cols-1 md:grid-cols-3" aria-label="global">
    <div class="col-span-1 flex flex-row items-start justify-between">
      <a
        href={`/${locale}/`}
        class="flex-none text-2xl font-semibold uppercase text-[var(--color-secondary-foreground)]"
        aria-label="home"
      >
        Shih-Chen<span class="text-[var(--color-accent-300)]">Liu</span>
      </a>

      <div class="flex items-center gap-2">
        <a
          href={href}
          hreflang={other}
          class="rounded-md border border-[var(--color-border)] bg-[var(--color-background-tertiary)] px-2.5 py-1.5 text-xs font-semibold transition-all hover:bg-[var(--color-accent-300)]"
          aria-label={other === "en" ? "Switch to English" : "切換為繁體中文"}
        >
          {otherLabel}
        </a>
        <button
          id="theme-toggle"
          type="button"
          class="rounded-md border border-[var(--color-border)] bg-[var(--color-background-tertiary)] p-1.5 transition-all hover:bg-[var(--color-accent-300)]"
          aria-label="Toggle colour theme"
        >
          <svg
            width="1.2rem"
            height="1.2rem"
            viewBox="0 0 24 24"
            class="rotate-0 scale-100 transition-all hover:text-white dark:hidden dark:-rotate-90 dark:scale-0"
          >
            <path
              fill="currentColor"
              d="M12 15q1.25 0 2.125-.875T15 12q0-1.25-.875-2.125T12 9q-1.25 0-2.125.875T9 12q0 1.25.875 2.125T12 15m0 1q-1.671 0-2.836-1.164T8 12q0-1.671 1.164-2.836T12 8q1.671 0 2.836 1.164T16 12q0 1.671-1.164 2.836T12 16m-7-3.5H1.5v-1H5zm17.5 0H19v-1h3.5zM11.5 5V1.5h1V5zm0 17.5V19h1v3.5zM6.746 7.404l-2.16-2.098.695-.744 2.111 2.134zM18.72 19.438l-2.117-2.14.652-.702 2.16 2.098zM16.596 6.746l2.098-2.16.744.695-2.134 2.111zM4.562 18.72l2.14-2.117.663.652-2.078 2.179zM12 12"
            ></path>
          </svg>
          <svg
            width="1.2rem"
            height="1.2rem"
            viewBox="0 0 24 24"
            class="hidden rotate-90 scale-0 text-white transition-all dark:rotate-0 dark:scale-100"
          >
            <path
              fill="currentColor"
              d="M12.058 20q-3.334 0-5.667-2.333Q4.058 15.333 4.058 12q0-3.038 1.98-5.27Q8.02 4.5 10.942 4.097q.081 0 .159.006t.153.017q-.506.706-.801 1.57q-.295.865-.295 1.811q0 2.667 1.866 4.533q1.867 1.867 4.534 1.867q.952 0 1.813-.295q.862-.295 1.548-.801q.012.075.018.153q.005.078.005.158q-.384 2.923-2.615 4.904T12.057 20"
            ></path>
          </svg>
        </button>
        <button
          id="menu-toggle"
          type="button"
          class="rounded-md border border-[var(--color-border)] bg-[var(--color-background-tertiary)] p-1.5 shadow-xl transition-all md:hidden dark:shadow-black/50"
          aria-label="Menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg
            width="1em"
            height="1em"
            viewBox="0 0 50 50"
            fill="none"
            stroke="currentColor"
            class="block"
            data-icon="open"
          >
            <path fill="currentColor" d="M3 9a1 1 0 1 0 0 2h44a1 1 0 1 0 0-2zm0 15a1 1 0 1 0 0 2h44a1 1 0 1 0 0-2zm0 15a1 1 0 1 0 0 2h44a1 1 0 1 0 0-2z"
            ></path>
          </svg>
          <svg
            width="1em"
            height="1em"
            viewBox="0 0 50 50"
            fill="none"
            stroke="currentColor"
            class="hidden"
            data-icon="close"
          >
            <path
              fill="currentColor"
              d="M7.719 6.281 6.28 7.72 23.563 25 6.28 42.281l1.44 1.439L25 26.438l17.281 17.28 1.438-1.437L26.438 25l17.28-17.281-1.437-1.438L25 23.563Z"
            ></path>
          </svg>
        </button>
      </div>
    </div>

    <div
      id="mobile-menu"
      class="card-nav mt-1.5 hidden flex-grow flex-col items-center justify-between gap-4 p-5 text-[var(--color-secondary-foreground)] shadow-xl md:hidden dark:shadow-black/50"
      data-mobile-menu
    >
      {
        anchors.map((a) => (
          <a
            href={a.href}
            class="flex-none text-[1.05rem] font-medium transition-all hover:text-[var(--color-accent-300)]"
          >
            {a.label}
          </a>
        ))
      }
    </div>

    <div
      class="card-nav z-10 col-span-2 mb-5 hidden flex-row items-center justify-between rounded-2xl text-[var(--color-secondary-foreground)] shadow-xl md:flex dark:shadow-black/50"
    >
      {
        anchors.map((a) => (
          <a
            href={a.href}
            class="flex-none text-[1.05rem] font-medium transition-all hover:text-[var(--color-accent-300)]"
          >
            {a.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById("menu-toggle");
    var menu = document.querySelector("[data-mobile-menu]");
    var open = document.querySelector('[data-icon="open"]');
    var close = document.querySelector('[data-icon="close"]');
    if (btn && menu) {
      btn.addEventListener("click", function () {
        var hidden = menu.classList.toggle("hidden");
        btn.setAttribute("aria-expanded", String(!hidden));
        if (open) open.classList.toggle("hidden", !hidden);
        if (close) close.classList.toggle("hidden", hidden);
      });
    }
  })();
</script>
