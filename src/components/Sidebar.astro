---
import type { Locale } from "../lib/i18n";
import { identity } from "../data/resume";
import { contact } from "../data/contact";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props as Props;
const hasPhoto = false; // TODO: 放入 public/photo.jpg 後改為 true

const socials = [
  { key: "github", label: "GitHub", href: contact.links.github, d: "M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21" },
  { key: "youtube", label: "YouTube", href: contact.links.youtube, d: "22 12a10 10 0 1 1-20 0 10 10 0 0 1 20 0M15 10l-5 2.5 5 2.5z" },
  { key: "linkedin", label: "LinkedIn", href: contact.links.linkedin, d: "M4 6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2zM8 11v5m0-8v.01M12 16v-5M16 16v-3a2 2 0 0 0-4 0" },
];

/* 隱私說明：AstroResume01 的側欄原本放電話與信箱，但那些值即使被 CSS 遮住，
   仍會留在 HTML 原始碼裡被爬蟲讀走。因此首頁側欄只放非識別性資訊；
   真實手機／信箱／地址只存在 /resume/（noindex、列印用）與回信中。 */
const rows: {
  icon: string;
  label: { zh: string; en: string };
  value?: string;
  text?: { zh: string; en: string };
}[] = [
  { icon: "badge", label: { zh: "職稱", en: "Role" }, value: identity.currentTitle[locale] },
  { icon: "cpu", label: { zh: "專長領域", en: "Focus" }, value: identity.kicker[locale] },
  { icon: "loc", label: { zh: "地點", en: "Location" }, value: contact.city[locale] },
  {
    icon: "globe",
    label: { zh: "語言", en: "Language" },
    text: { zh: "中文（母語）· 英文 TOEIC 825", en: "Chinese (native) · English TOEIC 825" },
  },
  { icon: "cap", label: { zh: "最高學歷", en: "Top degree" }, value: "逢甲大學 資訊電機工程 碩士" },
  { icon: "pin", label: { zh: "可到崗", en: "Availability" }, value: contact.availability[locale] },
];
---

<!--
  The reference uses `justify-center` + `h-screen`, which only works because its
  sidebar content is ~690px. This sidebar is taller (6 info rows + 2 CTAs), so
  centring would push the portrait above the viewport and swallow the pt-16
  offset that keeps it clear of the fixed header. Start-aligned instead, and
  drop h-screen so the taller card is not clipped.
-->
<aside
  class="top-5 flex flex-col items-center justify-start pt-16 md:sticky md:col-span-1 md:pl-5 print-hide"
>
  {
    hasPhoto ? (
      <img
        src="/photo.jpg"
        alt={identity.name[locale]}
        width="448"
        height="448"
        class="bg-accent-200 z-10 h-56 w-auto rounded-3xl p-1"
      />
    ) : (
      <div
        class="z-10 grid h-56 w-56 shrink-0 place-items-center rounded-3xl bg-[var(--color-accent-200)] p-1 text-6xl"
        aria-hidden="true"
      >
        👤
      </div>
    )
  }

  <div class="relative mt-[-6rem] w-full max-w-[400px] shrink-0 rounded-2xl bg-[var(--color-background-tertiary)] p-5">
    <div class="flex flex-col gap-y-1.5">
      <div class="flex flex-col items-center gap-y-4 pb-10 pt-24">
        <div class="flex flex-col items-center gap-y-3">
          <h1 class="text-3xl font-bold text-[var(--color-secondary-foreground)]">
            {identity.name[locale]}
          </h1>
          <h2 class="text-xl text-[var(--color-secondary-foreground)]">
            {identity.currentTitle[locale]}
          </h2>
          <p class="-mt-1 text-sm font-medium text-[var(--color-accent-300)]">
            {identity.kicker[locale]}
          </p>
        </div>

      <div class="flex flex-row gap-x-3 pb-2 pt-2">
        {
          socials.map((s) =>
            s.href && s.href !== "TODO" ? (
              <a href={s.href} target="_blank" rel="noopener" aria-label={s.label} class="icon-tile">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d={s.d} />
                </svg>
              </a>
            ) : (
              <span class="icon-tile opacity-35" title={`${s.label}: TODO`} aria-hidden="true">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d={s.d} />
                </svg>
              </span>
            )
          )
        }
      </div>

      <div class="relative flex w-full flex-col gap-x-7 gap-y-1 rounded-2xl bg-[var(--color-background-secondary)] p-5 text-[var(--color-secondary-foreground)]">
        {
          rows.map((r, i) => (
            <>
              <div class="flex flex-row items-center gap-x-2 py-1.5">
                <div class="icon-tile">
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    {r.icon === "badge" && (
                      <>
                        <circle cx="12" cy="8" r="4" />
                        <path d="M4 21a8 8 0 0 1 16 0" />
                      </>
                    )}
                    {r.icon === "cpu" && (
                      <>
                        <rect x="4" y="4" width="16" height="16" rx="2" />
                        <rect x="9" y="9" width="6" height="6" />
                        <path d="M9 1v3M15 1v3M9 20v3M15 20v3M1 9h3M1 15h3M20 9h3M20 15h3" />
                      </>
                    )}
                    {r.icon === "loc" && (
                      <>
                        <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0" />
                        <circle cx="12" cy="10" r="3" />
                      </>
                    )}
                    {r.icon === "globe" && (
                      <>
                        <circle cx="12" cy="12" r="9" />
                        <path d="M3 12h18M12 3a15 15 0 0 1 0 18 15 15 0 0 1 0-18" />
                      </>
                    )}
                    {r.icon === "cap" && (
                      <>
                        <path d="M22 9 12 4 2 9l10 5z" />
                        <path d="M6 11.5V16c0 1.5 3 3 6 3s6-1.5 6-3v-4.5" />
                      </>
                    )}
                    {r.icon === "pin" && (
                      <>
                        <circle cx="12" cy="12" r="9" />
                        <path d="M12 7v5l3 2" />
                      </>
                    )}
                  </svg>
                </div>
                <div class="flex flex-col">
                  <span class="label-accent">{r.label[locale]}</span>
                  <span class="font-bold text-[var(--color-secondary-foreground)] dark:text-white">
                    {r.value ?? r.text?.[locale]}
                  </span>
                </div>
              </div>
              {i < rows.length - 1 && <div class="border-t border-[var(--color-border)]" />}
            </>
          ))
        }
      </div>

      <div class="flex w-full flex-col gap-2">
        <a href={`/${locale}/resume/`} class="btn-accent w-full">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"></path>
          </svg>
          <p class="text-lg font-bold">{locale === "zh" ? "下載 A4 履歷" : "Download CV"}</p>
        </a>
        <a href={`/${locale}/contact/`} class="btn-ghost w-full">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M10 21v-6.5a3.5 3.5 0 0 0-7 0V21h18v-6a4 4 0 0 0-4-4H6.5"></path>
            <path d="M12 11V3h4l2 2-2 2h-4m-6 8h1"></path>
          </svg>
          {locale === "zh" ? "聯絡我（表單）" : "Contact me (form)"}
        </a>
      </div>

      <p class="pii-note text-center">
        🔒 {locale === "zh"
          ? "本站不公開電話與信箱；手機、信箱與完整地址請由 A4 履歷取得"
          : "Phone, email and full address are not published; get them from the printable CV"}
      </p>
      </div>
    </div>
  </div>
</aside>
