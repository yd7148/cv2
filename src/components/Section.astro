    <svg width="24" height="24" viewBox="0 0 100 100" aria-hidden="true">
      <path
        fill="currentColor"
        d="M50 14c-19.87 0-36 16.13-36 36s16.13 36 36 36 36-16.13 36-36-16.13-36-36-36m0 2c18.79 0 34 15.21 34 34S68.79 84 50 84 16 68.79 16 50s15.21-34 34-34m0 5c-13.367 0-24.63 9.048-27.982 21.36a.5.5 0 0 0 .964.263C26.22 30.74 37.085 22 50 22c7.56 0 14.414 2.993 19.451 7.86a.5.5 0 1 0 .695-.72A28.9 28.9 0 0 0 50 21m21.664 9.994a.5.5 0 0 0-.365.83q.411.483.803.983a.5.5 0 0 0 .789-.614q-.405-.519-.83-1.017a.5.5 0 0 0-.397-.182m2.256 3a.5.5 0 0 0-.42.78 28 28 0 0 1 1.166 1.964.5.5 0 0 0 .88-.476 29 29 0 0 0-1.206-2.035.5.5 0 0 0-.42-.233m2.146 4a.5.5 0 0 0-.439.707A27.9 27.9 0 0 1 78 50c0 15.47-12.53 28-28 28S22 65.47 22 50q.001-1.747.209-3.44a.5.5 0 0 0-.992-.12A29 29 0 0 0 21 50c0 16.01 12.99 29 29 29s29-12.99 29-29a28.9 28.9 0 0 0-2.457-11.701.5.5 0 0 0-.477-.305"
      ></path>
    </svg>
    <h2 class="pl-2 font-bold">{title}</h2>
  </div>
  <div class="flex flex-col gap-y-3">
    <slot />
  </div>
</section>
