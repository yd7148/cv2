---
import Base from "../../layouts/Base.astro";
import { useT } from "../../lib/i18n";
import { identity } from "../../data/resume";

const locale = "en" as const;
const t = useT(locale);
// TODO: replace with real Web3Forms access key
const WEB3FORMS_KEY = "TODO_WEB3FORMS_ACCESS_KEY";
---

<Base
  locale={locale}
  title={`Contact | ${identity.name.en}`}
  description="Get in touch with Shih-Chen Liu. Phone and email are deliberately not published."
>
  <div class="container-x py-12 sm:py-16 max-w-2xl">
    <h1 class="text-3xl sm:text-4xl font-extrabold">✉️ {t.contact.title}</h1>
    <p class="mt-3 text-[15px] leading-relaxed text-[var(--color-muted)]">{t.contact.lead}</p>

    <form class="mt-8 card p-6 space-y-4" action="https://api.web3forms.com/submit" method="POST">
      <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
      <input type="hidden" name="from_name" value={identity.name.en} />
      <input type="hidden" name="subject" value="Website contact form" />
      <input type="hidden" name="redirect" value="https://yd7148.workers.dev/en/contact/?sent=1" />
      <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" />

      <label class="block">
        <span class="text-sm font-semibold">{t.contact.name} *</span>
        <input
          required
          name="name"
          type="text"
          class="mt-1.5 w-full rounded-lg border border-[var(--color-line)] bg-[var(--color-bg)] px-3.5 py-2.5 text-sm"
        />
      </label>
      <label class="block">
        <span class="text-sm font-semibold">{t.contact.company}</span>
        <input
          name="company"
          type="text"
          class="mt-1.5 w-full rounded-lg border border-[var(--color-line)] bg-[var(--color-bg)] px-3.5 py-2.5 text-sm"
        />
      </label>
      <label class="block">
        <span class="text-sm font-semibold">{t.contact.role}</span>
        <input
          name="position"
          type="text"
          class="mt-1.5 w-full rounded-lg border border-[var(--color-line)] bg-[var(--color-bg)] px-3.5 py-2.5 text-sm"
        />
      </label>
      <label class="block">
        <span class="text-sm font-semibold">{t.contact.reason}</span>
        <select
          name="topic"
          class="mt-1.5 w-full rounded-lg border border-[var(--color-line)] bg-[var(--color-bg)] px-3.5 py-2.5 text-sm"
        >
          <option>Would like to understand my background and skills</option>
          <option>Would like to discuss an opportunity / interview</option>
          <option>Would like to request a PDF CV</option>
          <option>Technical exchange on SiC / smart manufacturing</option>
          <option>Other</option>
        </select>
      </label>
      <label class="block">
        <span class="text-sm font-semibold">{t.contact.message} *</span>
        <textarea
          required
          name="message"
          rows="5"
          class="mt-1.5 w-full rounded-lg border border-[var(--color-line)] bg-[var(--color-bg)] px-3.5 py-2.5 text-sm"
        ></textarea>
      </label>

      <button type="submit" class="btn btn-primary w-full">📨 {t.contact.submit}</button>
      <p class="text-xs text-[var(--color-muted)]">🔒 {t.contact.privacy}</p>
    </form>

    <div class="mt-8 p-4 rounded-xl border border-[var(--color-line)] bg-[var(--color-surface)] text-sm">
      <p class="font-semibold">📄 Need a PDF CV?</p>
      <p class="mt-1.5 text-[var(--color-muted)]">
        Open the <a
          href={`/${locale}/resume/`}
          class="text-[var(--color-brand)] link-underline">printable résumé</a
        > and hit "Print / Save as PDF".
      </p>
    </div>
  </div>
</Base>
