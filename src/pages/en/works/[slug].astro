---
import { getCollection, render } from "astro:content";
import Base from "../../../layouts/Base.astro";
import { useT, altPath, stripBase, lp } from "../../../lib/i18n";
import { identity } from "../../../data/resume";

export async function getStaticPaths() {
  const all = await getCollection("works", (w) => w.data.lang === "en");
  return all.map((w) => ({ params: { slug: w.id.replace(/-(zh|en)$/, "") }, props: { entry: w } }));
}

const { entry } = Astro.props;
const d = entry.data;
const locale = "en" as const;
const t = useT(locale);
const { Content } = await render(entry);
const alt = altPath(stripBase(Astro.url.pathname, import.meta.env.BASE_URL), "zh");

const all = (await getCollection("works", (w) => w.data.lang === locale)).sort(
  (a, b) => a.data.order - b.data.order
);
const idx = all.findIndex((w) => w.id === entry.id);
const prev = idx > 0 ? all[idx - 1] : undefined;
const next = idx >= 0 && idx < all.length - 1 ? all[idx + 1] : undefined;
const href = (e: typeof prev) => (e ? `${lp(locale, `/works/${e.id.replace(/-(zh|en)$/, "")}/`)}` : "");
---

<Base locale={locale} title={`${d.title} | ${identity.name.en}`} description={d.summary}>
  <article class="container-x py-12 sm:py-16">
    <a
      href={`${lp(locale, "/works/")}`}
      class="text-sm text-[var(--color-muted)] hover:text-[var(--color-brand)] print-hide"
      >&larr; {t.nav.works}</a
    >

    <header class="mt-4">
      <div class="flex items-start gap-4">
        <span class="text-4xl leading-none mt-1" aria-hidden="true">{d.icon}</span>
        <div class="min-w-0">
          <h1 class="text-3xl sm:text-4xl font-extrabold leading-tight">{d.title}</h1>
          <p class="mt-2 text-[var(--color-muted)] text-sm">
            {d.org && <span>{d.org}</span>}
            {d.org && d.period && <span> · </span>}
            {d.period && <span class="tabular-nums">{d.period}</span>}
          </p>
        </div>
      </div>
      <p class="mt-5 text-lg leading-relaxed max-w-3xl">{d.summary}</p>
      {
        d.todo.length > 0 && (
          <p class="mt-3 text-xs text-[var(--color-accent)] flex items-start gap-1.5">
            <span aria-hidden="true">✏️</span>
            <span>{d.todo.join(" / ")}</span>
          </p>
        )
      }
      <a
        href={alt}
        hreflang="zh-Hant-TW"
        class="print-hide mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-[var(--color-brand)] link-underline"
        >🌐 改用繁體中文閱讀</a
      >
    </header>

    <div class="mt-8 flex flex-wrap gap-1.5">
      {d.tech.map((x) => <span class="chip text-xs">{x}</span>)}
    </div>

    <div class="mt-10 space-y-8">
      <section>
        <h2 class="section-title">📝 Summary</h2>
        <div class="max-w-3xl leading-relaxed"><Content /></div>
      </section>
      {
        d.problem && (
          <section>
            <h2 class="section-title">🎯 Problem</h2>
            <p class="leading-relaxed text-[15px] max-w-3xl">{d.problem}</p>
          </section>
        )
      }
      <div class="grid gap-8 lg:grid-cols-2">
        {
          d.approach.length > 0 && (
            <section>
              <h2 class="section-title">🛠️ Approach</h2>
              <ul class="space-y-2.5">
                {d.approach.map((x) => (
                  <li class="text-[15px] leading-relaxed flex gap-2.5">
                    <span class="text-[var(--color-brand)] shrink-0" aria-hidden="true">
                      ▸
                    </span>
                    <span>{x}</span>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
        {
          d.impact.length > 0 && (
            <section>
              <h2 class="section-title">📈 Impact</h2>
              <ul class="space-y-2.5">
                {d.impact.map((x) => (
                  <li class="text-[15px] leading-relaxed flex gap-2.5">
                    <span class="text-[var(--color-brand)] shrink-0" aria-hidden="true">
                      ✓
                    </span>
                    <span>{x}</span>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </div>
    </div>

    {
      d.links.length > 0 && (
        <div class="mt-10 pt-6 border-t border-[var(--color-line)] flex flex-wrap gap-3 print-hide">
          {d.links.map((l) => (
            <a href={l.url} target="_blank" rel="noopener" class="btn text-sm">
              🔗 {l.label}
            </a>
          ))}
        </div>
      )
    }

    <nav class="mt-10 pt-6 border-t border-[var(--color-line)] grid sm:grid-cols-2 gap-3 print-hide">
      {
        prev ? (
          <a href={href(prev)} class="card p-4 hover:border-[var(--color-brand)]">
            <p class="text-xs text-[var(--color-muted)]">&larr;</p>
            <p class="mt-1 font-semibold text-sm leading-snug">{prev.data.title}</p>
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a href={href(next)} class="card p-4 hover:border-[var(--color-brand)] sm:text-right">
            <p class="text-xs text-[var(--color-muted)]">&rarr;</p>
            <p class="mt-1 font-semibold text-sm leading-snug">{next.data.title}</p>
          </a>
        )
      }
    </nav>
  </article>
</Base>
