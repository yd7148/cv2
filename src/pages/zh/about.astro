---
import Base from "../../layouts/Base.astro";
import { useT } from "../../lib/i18n";
import { identity, experience, education, certifications, keywords } from "../../data/resume";
import { contact } from "../../data/contact";

const locale = "zh" as const;
const t = useT(locale);
const realLinks = Object.entries(contact.links).filter(
  ([, v]) => v && v !== "TODO"
) as [string, string][];
---

<Base
  locale={locale}
  title={`關於我｜${identity.name.zh}`}
  description={identity.summary.zh}
>
  <div class="container-x py-12 sm:py-16 max-w-4xl">
    <h1 class="text-3xl sm:text-4xl font-extrabold">關於我</h1>
    <p class="mt-4 text-[15px] leading-relaxed text-[var(--color-muted)]">{identity.summary.zh}</p>

    <h2 class="section-title mt-12">💼 工作經歷</h2>
    {
      experience.map((e) => (
        <div class="card p-5 mb-3 avoid-break">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h3 class="font-bold">{e.company.zh}</h3>
            <span class="text-sm tabular-nums text-[var(--color-muted)]">{e.period}</span>
          </div>
          <p class="mt-0.5 text-sm font-semibold text-[var(--color-brand)]">{e.title.zh}</p>
          <p class="text-[13px] text-[var(--color-muted)]">
            {e.dept.zh} · {e.location.zh}
          </p>
          <ul class="mt-3 space-y-1.5">
            {e.bullets.map((b) => (
              <li class="text-sm leading-relaxed flex gap-2">
                <span class="text-[var(--color-brand)] shrink-0" aria-hidden="true">
                  ·
                </span>
                <span>{b.zh}</span>
              </li>
            ))}
          </ul>
          {e.todo.length > 0 && (
            <p class="mt-3 text-xs text-[var(--color-accent)]">✏️ {e.todo.join(" / ")}</p>
          )}
        </div>
      ))
    }

    <h2 class="section-title mt-12">🎓 學歷與論文</h2>
    {
      education.map((e) => (
        <div class="card p-5 mb-3 avoid-break">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h3 class="font-bold">{e.school.zh}</h3>
            <span class="text-sm tabular-nums text-[var(--color-muted)]">{e.period}</span>
          </div>
          <p class="mt-0.5 text-sm text-[var(--color-brand)] font-semibold">{e.degree.zh}</p>
          {e.thesis && (
            <div class="mt-3 text-sm">
              <p class="font-semibold">{e.thesis.title.zh}</p>
              <p class="mt-1 text-xs text-[var(--color-muted)]">
                {e.thesis.advisor.zh} · {e.thesis.oral.zh}
              </p>
              <a
                href={e.thesis.url}
                target="_blank"
                rel="noopener"
                class="text-xs text-[var(--color-brand)] link-underline break-all"
              >
                🔗 {e.thesis.url}
              </a>
            </div>
          )}
        </div>
      ))
    }

    <h2 class="section-title mt-12">🏅 證照與進修</h2>
    <ul class="space-y-2">
      {
        certifications.map((c) => (
          <li class="text-sm flex gap-2">
            <span aria-hidden="true">{c.icon}</span>
            <span>
              <span class="font-semibold">{c.name.zh}</span>
              <span class="text-[var(--color-muted)]">
                {" "}
                — {c.issuer.zh}
                {c.date && ` · ${c.date}`}
              </span>
            </span>
          </li>
        ))
      }
    </ul>

    <h2 class="section-title mt-12">🏷️ 關鍵字</h2>
    <div class="flex flex-wrap gap-2">
      {keywords.zh.map((k) => <span class="chip">{k}</span>)}
    </div>

    <h2 class="section-title mt-12">🔗 連結</h2>
    {
      realLinks.length > 0 ? (
        <div class="flex flex-wrap gap-2">
          {realLinks.map(([k, v]) => (
            <a href={v} target="_blank" rel="noopener" class="btn text-sm">
              {k} ↗
            </a>
          ))}
        </div>
      ) : (
        <p class="text-sm text-[var(--color-accent)]">
          ✏️ TODO：GitHub / YouTube / LinkedIn 連結待補（填入{" "}
          <code class="rounded bg-[var(--color-surface)] px-1">src/data/contact.ts</code>）
        </p>
      )
    }

    <div class="mt-12 p-5 rounded-xl border border-[var(--color-line)] bg-[var(--color-surface)]">
      <p class="font-semibold">🔒 關於我的聯絡方式</p>
      <p class="mt-1.5 text-sm text-[var(--color-muted)]">{t.hero.privacyNote}</p>
      <a href={`/${locale}/contact/`} class="btn btn-primary mt-4 inline-flex">✉️ {t.hero.ctaContact}</a>
    </div>
  </div>
</Base>
